{
  "expo": {
    "name": "Reservas Deportivas Villaguay",
    "slug": "reservas-deportivas-villaguay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "reservasvillaguay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.gob.villaguay.reservasdeportivas",
      "infoPlist": {
        "NSCameraUsageDescription": "Permite escanear el código QR del turno en la entrada del complejo deportivo.",
        "NSLocationWhenInUseUsageDescription": "Permite ubicar los complejos deportivos de Villaguay en el mapa.",
        "NSFaceIDUsageDescription": "Permite validar tu identidad mediante biometría para ingresar al sistema."
      }
    },
    "android": {
      "package": "ar.gob.villaguay.reservasdeportivas",
      "adaptiveIcon": {
        "backgroundColor": "#1A4D2E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear el código QR del turno en la entrada del complejo deportivo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite ubicar los complejos deportivos en el mapa y calcular distancias."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite validar tu identidad mediante biometría."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A4D2E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e0aed43-a9ec-47c3-8351-9ed9214e6b6b"
      }
    },
    "owner": "jgroman"
  }
}
